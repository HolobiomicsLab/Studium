{
  "name": "Studium",
  "version": "1.0.0",
  "description": "Paper, ink and a path through knowledge. Semantic colours are paired inks and pale surfaces; colour never carries status alone.",
  "color": {
    "light": {
      "canvas": "#f5f2eb",
      "surface": "#fffdf8",
      "surface-raised": "#ffffff",
      "surface-muted": "#eae6dd",
      "text": "#172d38",
      "muted": "#52646b",
      "accent": "#176b60",
      "accent-hover": "#105149",
      "accent-soft": "#dceae5",
      "on-accent": "#fffdf8",
      "accent-2": "#85531c",
      "accent-2-soft": "#f4e6ce",
      "success": "#25654a",
      "success-soft": "#e0ede5",
      "warning": "#85531c",
      "warning-soft": "#f4e6ce",
      "danger": "#a33c31",
      "danger-soft": "#f5e3df",
      "info": "#245e86",
      "info-soft": "#e3edf5",
      "focus": "#21688e",
      "border": "#cbc8be",
      "border-strong": "#748184",
      "scene-ungraded": "#52646b",
      "scene-ungraded-soft": "#e8eceb",
      "scene-author-keyed": "#85531c",
      "scene-author-keyed-soft": "#f4e6ce",
      "scene-production": "#245e86",
      "scene-production-soft": "#e3edf5",
      "scene-externally-grounded": "#25654a",
      "scene-externally-grounded-soft": "#e0ede5",
      "node-concept": "#176b60",
      "node-concept-soft": "#dceae5",
      "node-task": "#245e86",
      "node-task-soft": "#e3edf5",
      "node-mastered": "#25654a",
      "node-mastered-soft": "#e0ede5",
      "node-due": "#85531c",
      "node-due-soft": "#f4e6ce",
      "brand-ochre": "#b87927"
    },
    "dark": {
      "canvas": "#13252c",
      "surface": "#1a3038",
      "surface-raised": "#223c44",
      "surface-muted": "#263e45",
      "text": "#f2f2e9",
      "muted": "#b2c4c7",
      "accent": "#8bd5c4",
      "accent-hover": "#abe4d7",
      "accent-soft": "#213e3a",
      "on-accent": "#13252c",
      "accent-2": "#edc184",
      "accent-2-soft": "#423528",
      "success": "#a2d8b7",
      "success-soft": "#253e33",
      "warning": "#edc184",
      "warning-soft": "#423528",
      "danger": "#ffb4a6",
      "danger-soft": "#4a2e2c",
      "info": "#a9d1ef",
      "info-soft": "#243c50",
      "focus": "#b4dcfa",
      "border": "#3b535b",
      "border-strong": "#829b9e",
      "scene-ungraded": "#b2c4c7",
      "scene-ungraded-soft": "#2c4148",
      "scene-author-keyed": "#edc184",
      "scene-author-keyed-soft": "#423528",
      "scene-production": "#a9d1ef",
      "scene-production-soft": "#243c50",
      "scene-externally-grounded": "#a2d8b7",
      "scene-externally-grounded-soft": "#253e33",
      "node-concept": "#8bd5c4",
      "node-concept-soft": "#213e3a",
      "node-task": "#a9d1ef",
      "node-task-soft": "#243c50",
      "node-mastered": "#a2d8b7",
      "node-mastered-soft": "#253e33",
      "node-due": "#edc184",
      "node-due-soft": "#423528",
      "brand-ochre": "#edc184"
    }
  },
  "alias": {
    "button-background": "accent",
    "button-foreground": "on-accent",
    "button-hover-background": "accent-hover",
    "input-background": "surface",
    "input-foreground": "text",
    "input-border": "border-strong",
    "input-placeholder": "muted"
  },
  "typography": {
    "font": {
      "display": "Georgia, 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', serif",
      "text": "'Avenir Next', Avenir, 'Segoe UI', system-ui, sans-serif",
      "mono": "ui-monospace, 'SFMono-Regular', Consolas, 'Liberation Mono', monospace"
    },
    "size": { "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "md": "1.125rem", "lg": "1.375rem", "xl": "1.75rem", "2xl": "2.25rem", "3xl": "3rem", "4xl": "4.5rem" },
    "weight": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" },
    "leading": { "tight": "1.15", "snug": "1.35", "body": "1.6" },
    "tracking": { "display": "-0.035em", "label": "0.08em" }
  },
  "spacing": { "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.25rem", "6": "1.5rem", "8": "2rem", "10": "2.5rem", "12": "3rem", "16": "4rem", "20": "5rem", "24": "6rem" },
  "radius": { "small": "0.25rem", "medium": "0.5rem", "large": "1rem", "pill": "999px" },
  "borderWidth": { "default": "1px", "strong": "2px", "focus": "3px" },
  "layout": { "measure": "65ch", "pane": "46rem", "target": "2.75rem" },
  "shadow": {
    "light": { "small": "0 2px 8px rgb(23 45 56 / 6%)", "raised": "0 12px 36px rgb(23 45 56 / 10%)" },
    "dark": { "small": "0 2px 8px rgb(0 0 0 / 15%)", "raised": "0 12px 36px rgb(0 0 0 / 24%)" }
  },
  "motion": {
    "duration": { "instant": "0ms", "fast": "120ms", "normal": "180ms", "slow": "240ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)" },
    "reducedMotion": { "query": "(prefers-reduced-motion: reduce)", "duration": "0ms", "animation": "none", "scrollBehavior": "auto", "rule": "Remove non-essential animation and transitions; retain explicit textual loading and status feedback." }
  },
  "semantics": {
    "sceneClasses": {
      "ungraded": { "token": "scene-ungraded", "label": "Ungraded", "types": ["intro", "concept", "meta_checkpoint"] },
      "author_keyed": { "token": "scene-author-keyed", "label": "Author keyed", "types": ["quiz", "spot_the_flaw"] },
      "production": { "token": "scene-production", "label": "Production", "types": ["explain_back", "comparison", "summary_audit", "prompt_practice", "communication_sim", "discussion", "ai_critique"] },
      "externally_grounded": { "token": "scene-externally-grounded", "label": "Externally grounded", "types": ["reproduction"] }
    },
    "graph": {
      "concept": { "token": "node-concept", "shape": "circle", "role": "kind" },
      "task": { "token": "node-task", "shape": "rounded square", "role": "kind" },
      "mastered": { "token": "node-mastered", "shape": "check beside original node shape", "role": "state" },
      "due": { "token": "node-due", "shape": "clock beside original node shape", "role": "state" }
    },
    "feedback": { "correct": "success", "incorrect": "danger", "acknowledged": "info", "keyword-only": "warning" },
    "decorativeOnly": ["border", "brand-ochre"],
    "notes": ["Key class is not a verdict.", "Mastered and due are node states, not additional LWG node kinds.", "Keyword feedback is not certified assessment and does not update mastery or FSRS.", "Use border-strong for input boundaries; border is only a decorative divider."]
  },
  "contrastPairs": [
    { "foreground": "text", "backgrounds": ["canvas", "surface", "surface-raised", "surface-muted", "accent-soft", "accent-2-soft", "success-soft", "warning-soft", "danger-soft", "info-soft", "scene-ungraded-soft"], "kind": "text" },
    { "foreground": "muted", "backgrounds": ["canvas", "surface", "surface-raised", "surface-muted", "accent-soft", "accent-2-soft", "success-soft", "warning-soft", "danger-soft", "info-soft", "scene-ungraded-soft"], "kind": "text" },
    { "foreground": "accent", "backgrounds": ["canvas", "surface", "surface-raised", "accent-soft"], "kind": "text" },
    { "foreground": "accent-hover", "backgrounds": ["canvas", "surface"], "kind": "text" },
    { "foreground": "on-accent", "backgrounds": ["accent", "accent-hover"], "kind": "text" },
    { "foreground": "accent-2", "backgrounds": ["canvas", "surface", "accent-2-soft"], "kind": "text" },
    { "foreground": "success", "backgrounds": ["canvas", "surface", "success-soft"], "kind": "text" },
    { "foreground": "warning", "backgrounds": ["canvas", "surface", "warning-soft"], "kind": "text" },
    { "foreground": "danger", "backgrounds": ["canvas", "surface", "danger-soft"], "kind": "text" },
    { "foreground": "info", "backgrounds": ["canvas", "surface", "info-soft"], "kind": "text" },
    { "foreground": "scene-ungraded", "backgrounds": ["scene-ungraded-soft"], "kind": "text" },
    { "foreground": "scene-author-keyed", "backgrounds": ["scene-author-keyed-soft"], "kind": "text" },
    { "foreground": "scene-production", "backgrounds": ["scene-production-soft"], "kind": "text" },
    { "foreground": "scene-externally-grounded", "backgrounds": ["scene-externally-grounded-soft"], "kind": "text" },
    { "foreground": "node-concept", "backgrounds": ["node-concept-soft"], "kind": "text" },
    { "foreground": "node-task", "backgrounds": ["node-task-soft"], "kind": "text" },
    { "foreground": "node-mastered", "backgrounds": ["node-mastered-soft"], "kind": "text" },
    { "foreground": "node-due", "backgrounds": ["node-due-soft"], "kind": "text" },
    { "foreground": "border-strong", "backgrounds": ["canvas", "surface", "surface-raised", "surface-muted"], "kind": "ui" },
    { "foreground": "focus", "backgrounds": ["canvas", "surface", "surface-raised", "surface-muted"], "kind": "ui" },
    { "foreground": "accent", "backgrounds": ["surface-muted"], "kind": "ui" },
    { "foreground": "success", "backgrounds": ["surface-muted"], "kind": "ui" },
    { "foreground": "text", "backgrounds": ["canvas"], "kind": "large-text" }
  ]
}
