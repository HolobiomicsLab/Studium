    {
      "id": "s3b-explain-2p",
      "type": "explain_back",
      "title": "Explique — pourquoi la 2p a deux lobes",
      "objective_refs": [],
      "concept_refs": [
        "c-orbitales-formes"
      ],
      "estimated_seconds": 180,
      "adaptation_hooks": [],
      "prompt": "Tu viens de faire tourner l'orbitale **2p** en 3D : deux lobes de signe opposé séparés par un plan. **Explique, avec tes propres mots, pourquoi la 2p a deux lobes et ce que représente le plan qui les sépare** (pense à la fonction d'onde et à la probabilité de présence).",
      "key_points": [
        {
          "id": "kp-fonction",
          "text": "La forme découle de la fonction d'onde de l'électron",
          "cues": [
            "fonction d onde"
          ]
        },
        {
          "id": "kp-signe",
          "text": "Les deux lobes ont des signes opposés",
          "cues": [
