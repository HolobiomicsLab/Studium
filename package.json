{
  "name": "studium-prototype",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "test": "pnpm -r test",
    "lint": "eslint . --ext .ts,.tsx --no-error-on-unmatched-pattern",
    "build": "pnpm -r build",
    "build:libs": "pnpm --filter \"./packages/**\" run build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0"
  }
}
