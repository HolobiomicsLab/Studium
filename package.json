{
  "name": "studium-prototype",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "test": "pnpm -r test",
    "lint": "eslint . --ext .ts,.tsx --no-error-on-unmatched-pattern",
    "build": "pnpm -r build",
    "build:libs": "pnpm --filter \"./packages/**\" run build",
    "docs:gen": "node tools/docs/gen-mcp-tools.mjs && node tools/docs/gen-lesson-bundle.mjs",
    "docs:check": "node --test tools/docs/check.test.mjs && node tools/docs/check.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0"
  },
  "pnpm": {
    "overrides": {
      "next": "14.2.35",
      "@modelcontextprotocol/sdk": "^1.32.2",
      "fast-uri@>=3 <3.1.7": "^3.1.7",
      "ip-address@<10.3.1": "^10.3.1",
      "proxy-addr@<2.0.8": "^2.0.8",
      "body-parser@<2.4.0": "^2.4.0",
      "nanoid@<3.3.18": "^3.3.18",
      "browserslist@<4.28.7": "^4.28.7",
      "source-map-js@<1.2.2": "^1.2.2",
      "postcss@<8.5.18": "^8.5.18"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-p293-qw3h-jr36",
        "GHSA-2xp9-vwfh-vxw4",
        "GHSA-2464-fhr4-w9xw"
      ]
    }
  }
}
