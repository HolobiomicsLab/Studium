{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studium.dev/schemas/lesson-plan/v1",
  "title": "LessonPlan",
  "description": "Studium lesson plan v1 — sub-schema of lesson-schema v1 (ADR 003). Represents the author-validated plan before full scene synthesis.",
  "type": "object",
  "required": ["schema_version", "id", "title", "language", "target", "duration_minutes", "learning_objectives", "scene_outlines", "corpus_refs", "status"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "target": { "type": "string", "minLength": 1, "description": "Target audience / level (e.g. L3, M1, PhD)" },
    "duration_minutes": { "type": "integer", "minimum": 1 },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/LearningObjective" }
    },
    "scene_outlines": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/SceneOutline" }
    },
    "concepts": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/Concept" }
    },
    "corpus_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/CorpusRef" },
      "description": "Traceable references to source documents (local files or resolved DOIs)"
    },
    "critic_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Critic agent score [0..1] — set after critic review"
    },
    "critic_annotations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "critic_reviewed", "approved"],
      "description": "Workflow status — approved requires human validation (rule 003)"
    },
    "validated_by": {
      "type": "string",
      "description": "Author identifier who validated the plan (required when status=approved)"
    },
    "metadata": { "$ref": "#/$defs/Metadata" },
    "prov_entity_uri": { "type": "string" },
    "prov_derived_from": { "type": "array", "items": { "type": "string" } },
    "prov_generated_by": { "type": "string" },
    "schema_course_uri": { "type": "string" },
    "schema_educational_level": { "type": "string" },
    "dct_subject": { "type": "string" },
    "dct_language": { "type": "string" },
    "esco_occupation_uri": { "type": "string" },
    "case_framework_uri": { "type": "string" }
  },
  "$defs": {
    "Concept": {
      "type": "object",
      "required": ["id", "title", "description", "bloom_level_target"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "bloom_level_target": {
          "type": "string",
          "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]
        },
        "prerequisites": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        }
      }
    },
    "LearningObjective": {
      "type": "object",
      "required": ["id", "description", "bloom_level"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "bloom_level": {
          "type": "string",
          "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]
        },
        "concept_uris": { "type": "array", "items": { "type": "string" } },
        "skos_concept_uri": { "type": "string" },
        "skos_broader": { "type": "string" },
        "skos_related": { "type": "array", "items": { "type": "string" } },
        "esco_skill_uri": { "type": "string" },
        "esco_knowledge_uri": { "type": "string" },
        "case_item_uri": { "type": "string" },
        "edam_operation": { "type": "string" },
        "edam_topics": { "type": "array", "items": { "type": "string" } },
        "schema_alignment_uri": { "type": "string" },
        "bloom_uri": { "type": "string" }
      }
    },
    "BibliographicRef": {
      "type": "object",
      "required": ["perspicacite_doc_id", "title", "authors", "excerpt", "relevance_score", "prov_derived_from"],
      "additionalProperties": false,
      "properties": {
        "perspicacite_doc_id": { "type": "string", "minLength": 1 },
        "doi": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "authors": { "type": "array", "items": { "type": "string" } },
        "year": { "type": "integer" },
        "excerpt": { "type": "string", "maxLength": 500 },
        "relevance_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "prov_derived_from": { "type": "string", "minLength": 1 }
      }
    },
    "CaseStudy": {
      "type": "object",
      "required": ["title", "summary", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "maxLength": 1000 },
        "source_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ABSAsset": {
      "type": "object",
      "required": ["asset_type", "prov_derived_from"],
      "additionalProperties": false,
      "properties": {
        "asset_type": {
          "type": "string",
          "enum": ["spectrum_viewer_svg", "code_snippet", "data_csv", "protocol_card_md", "script_snippet"]
        },
        "payload_inline": { "type": "string" },
        "payload_path": { "type": "string" },
        "abs_task_card_id": { "type": "string" },
        "prov_derived_from": { "type": "string", "minLength": 1 }
      }
    },
    "EnrichmentMetadata": {
      "type": "object",
      "required": ["enricher_version", "perspicacite_mode_used", "timestamp", "degraded"],
      "additionalProperties": false,
      "properties": {
        "enricher_version": { "type": "string", "minLength": 1 },
        "perspicacite_mode_used": {
          "type": "string",
          "enum": ["basic", "advanced", "profound", "agentic", "passages"]
        },
        "timestamp": { "type": "string", "minLength": 1 },
        "degraded": { "type": "boolean" }
      }
    },
    "Evidence": {
      "type": "object",
      "required": ["enrichment_metadata"],
      "additionalProperties": false,
      "properties": {
        "bibliographic_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/BibliographicRef" }
        },
        "case_studies": {
          "type": "array",
          "items": { "$ref": "#/$defs/CaseStudy" }
        },
        "abs_asset": { "$ref": "#/$defs/ABSAsset" },
        "enrichment_metadata": { "$ref": "#/$defs/EnrichmentMetadata" }
      }
    },
    "SceneOutline": {
      "type": "object",
      "required": ["id", "type", "title", "objective_refs"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["intro", "concept", "quiz", "simulation", "reproduction", "discussion", "meta_checkpoint", "ai_critique", "spot_the_flaw"]
        },
        "title": { "type": "string", "minLength": 1 },
        "objective_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "concept_refs": {
          "type": "array",
          "default": [],
          "items": { "type": "string" }
        },
        "notes": { "type": "string" },
        "duration_minutes": { "type": "integer", "minimum": 1 },
        "evidence": { "$ref": "#/$defs/Evidence" },
        "evidence_override": { "type": "string", "enum": ["force", "skip"] },
        "skos_concept_uris": { "type": "array", "items": { "type": "string" } },
        "dct_subject": { "type": "string" },
        "prov_derived_from": { "type": "array", "items": { "type": "string" } },
        "dct_references": { "type": "array", "items": { "type": "string" } },
        "schema_educational_alignment": { "type": "array", "items": { "type": "string" } },
        "case_item_uri": { "type": "string" },
        "abs_task_card_id": { "type": "string" }
      }
    },
    "CorpusRef": {
      "type": "object",
      "required": ["ref_id", "ref_type"],
      "additionalProperties": true,
      "properties": {
        "ref_id": { "type": "string", "minLength": 1 },
        "ref_type": {
          "type": "string",
          "enum": ["local_file", "doi", "url", "offline", "abs_capsule"]
        },
        "title": { "type": "string" },
        "doi": { "type": "string" },
        "file_path": { "type": "string" },
        "resolved": { "type": "boolean" },
        "prov_entity_uri": { "type": "string" },
        "dct_source": { "type": "string" },
        "dct_references": { "type": "array", "items": { "type": "string" } },
        "skos_subject": { "type": "string" },
        "abs_capsule_path": { "type": "string" },
        "abs_task_card_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Metadata": {
      "type": "object",
      "required": ["subject", "author", "created"],
      "additionalProperties": true,
      "properties": {
        "subject": { "type": "string" },
        "author": { "type": "string" },
        "created": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
