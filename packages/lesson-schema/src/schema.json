{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studium.dev/schemas/lesson/v1",
  "title": "Lesson",
  "description": "Studium lesson schema v1 — ADR 003",
  "type": "object",
  "required": ["schema_version", "id", "title", "language", "learning_objectives", "scenes", "metadata"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/LearningObjective" }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Scene" }
    },
    "metadata": { "$ref": "#/$defs/Metadata" }
  },
  "$defs": {
    "LearningObjective": {
      "type": "object",
      "required": ["id", "description", "bloom_level"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "bloom_level": {
          "type": "string",
          "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]
        }
      }
    },
    "Scene": {
      "type": "object",
      "required": ["id", "type", "objective_refs", "modulators", "content", "success_criteria", "adaptation_hooks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["intro", "concept", "quiz", "simulation", "reproduction", "discussion", "meta_checkpoint", "ai_critique"]
        },
        "objective_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "modulators": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["M1", "M2", "M3", "M4", "M5", "M6"]
          }
        },
        "content": { "type": "object" },
        "success_criteria": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          ]
        },
        "adaptation_hooks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["on_error", "on_low_confidence", "on_high_confidence", "on_timeout", "on_revisit"]
          }
        },
        "composite": { "type": "boolean" },
        "secondary_objectives": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "Metadata": {
      "type": "object",
      "required": ["subject", "author", "created"],
      "additionalProperties": true,
      "properties": {
        "subject": { "type": "string" },
        "author": { "type": "string" },
        "created": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "version": { "type": "string" }
      }
    }
  }
}
