{
  "name": "studium-vscode",
  "displayName": "Studium",
  "description": "Run a Studium adaptive lesson in VS Code: a tutoring loop driven over the lesson-mcp server, with an artifact pane that renders each scene's figures, equations, interactive plots, and executed reference runs — pair by pair.",
  "version": "0.1.0",
  "private": true,
  "publisher": "holobiomicslab",
  "repository": {
    "type": "git",
    "url": "https://github.com/HolobiomicsLab/studium.git",
    "directory": "apps/studium-vscode"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onNotebook:studium-lesson",
    "onView:studiumLessons",
    "onCommand:studium.openLesson",
    "onCommand:studium.pickLesson",
    "onCommand:studium.openLessonNotebook",
    "onCommand:studium.communityContributions",
    "onCommand:studium.runReproduction",
    "onCommand:studium.openWalkthrough",
    "onChatParticipant:studium.tutor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "studium.openLesson",
        "title": "%command.openLesson.title%"
      },
      {
        "command": "studium.pickLesson",
        "title": "%command.pickLesson.title%"
      },
      {
        "command": "studium.openLessonNotebook",
        "title": "%command.openLessonNotebook.title%"
      },
      {
        "command": "studium.communityContributions",
        "title": "%command.communityContributions.title%"
      },
      {
        "command": "studium.runReproduction",
        "title": "%command.runReproduction.title%"
      },
      {
        "command": "studium.openWalkthrough",
        "title": "%command.openWalkthrough.title%"
      },
      {
        "command": "studium.refreshLessons",
        "title": "%command.refreshLessons.title%",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "studium",
          "title": "Studium",
          "icon": "media/studium-icon.svg"
        }
      ]
    },
    "views": {
      "studium": [
        {
          "id": "studiumLessons",
          "name": "%view.lessons.name%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "studium.refreshLessons",
          "when": "view == studiumLessons",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "studium.refreshLessons",
          "when": "false"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "studium.gettingStarted",
        "title": "Prise en main de Studium / Get started with Studium",
        "description": "Apprends à juger la sortie de l'IA dans ton éditeur : ouvre une leçon, exécute une reproduction, audite le résultat.",
        "steps": [
          {
            "id": "open",
            "title": "Choisis et ouvre une leçon / Pick and open a lesson",
            "description": "Depuis la barre d'activité Studium, choisis un cours découvert dans ton dossier de bundles, puis ouvre-le. Le panneau Studium affiche chaque scène — figures, équations, plots — et te pose des questions.\n[Choisir un cours](command:studium.pickLesson) · [Ouvrir le cours courant](command:studium.openLesson)",
            "media": {
              "markdown": "media/walkthrough/01-open.md"
            }
          },
          {
            "id": "judge",
            "title": "Juge la sortie de l'IA / Judge the AI's output",
            "description": "Sur une scène « spot the flaw », un jeu de cartes te demande, pour chaque affirmation, si elle est erronée ou correcte. C'est le cœur de Studium : calibrer ton jugement de la sortie de l'IA.",
            "media": {
              "markdown": "media/walkthrough/02-judge.md"
            }
          },
          {
            "id": "run",
            "title": "Exécute une reproduction / Run a reproduction",
            "description": "Une scène de reproduction fait tourner une vraie capsule dans ton espace de travail (Studium n'exécute jamais lui-même). Le résultat que TU produis fonde le jugement — s'il est attesté.\n[Lancer la reproduction](command:studium.runReproduction)",
            "media": {
              "markdown": "media/walkthrough/03-run.md"
            }
          }
        ]
      }
    ],
    "chatParticipants": [
      {
        "id": "studium.tutor",
        "name": "studium",
        "fullName": "Studium",
        "description": "Ouvre une leçon et juge la sortie de l'IA, directement dans le chat",
        "isSticky": true,
        "commands": [
          {
            "name": "start",
            "description": "Démarrer (ou redémarrer) la leçon"
          },
          {
            "name": "hint",
            "description": "Demander un indice"
          },
          {
            "name": "discuss",
            "description": "Prendre un tour de discussion (argumente une position)"
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "studium-run",
        "required": [
          "capsule"
        ],
        "properties": {
          "capsule": {
            "type": "string",
            "description": "The capsule_ref the reproduction scene runs (provisioned + executed in the user's workspace; Studium never executes)."
          }
        }
      }
    ],
    "notebooks": [
      {
        "type": "studium-lesson",
        "displayName": "Studium Lesson",
        "selector": [
          {
            "filenamePattern": "*.studium-lesson"
          }
        ]
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "studium.repoRoot": {
          "type": "string",
          "default": "",
          "description": "%configuration.repoRoot.description%"
        },
        "studium.bundlesRoot": {
          "type": "string",
          "default": "",
          "description": "%configuration.bundlesRoot.description%"
        },
        "studium.bundleRef": {
          "type": "string",
          "default": "atomistique-l1/lesson.json",
          "description": "%configuration.bundleRef.description%"
        },
        "studium.communityBundlesRoot": {
          "type": "string",
          "default": "",
          "description": "%configuration.communityBundlesRoot.description%"
        },
        "studium.assets": {
          "type": "string",
          "enum": [
            "vendor",
            "cdn"
          ],
          "default": "vendor",
          "description": "%configuration.assets.description%",
          "enumDescriptions": [
            "%configuration.assets.enum.0%",
            "%configuration.assets.enum.1%"
          ]
        },
        "studium.learnerId": {
          "type": "string",
          "default": "vscode-learner",
          "description": "%configuration.learnerId.description%"
        },
        "studium.telemetryConsent": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.telemetryConsent.description%"
        },
        "studium.showGraph": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showGraph.description%"
        },
        "studium.graphView": {
          "type": "string",
          "enum": [
            "student",
            "teacher"
          ],
          "default": "student",
          "description": "%configuration.graphView.description%",
          "enumDescriptions": [
            "%configuration.graphView.enum.0%",
            "%configuration.graphView.enum.1%"
          ]
        },
        "studium.showMastery": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.showMastery.description%"
        },
        "studium.modalityPreference": {
          "type": "string",
          "enum": [
            "visual",
            "textual",
            "balanced"
          ],
          "enumDescriptions": [
            "%configuration.modalityPreference.enum.0%",
            "%configuration.modalityPreference.enum.1%",
            "%configuration.modalityPreference.enum.2%"
          ],
          "default": "balanced",
          "description": "%configuration.modalityPreference.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js && esbuild src/lesson-mcp-entry.ts --bundle --platform=node --format=cjs --outfile=dist/lesson-mcp.cjs --define:__STUDIUM_BUILD__='{\"origin\":\"bundled\",\"built_at\":\"'\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"'\",\"git_sha\":\"'\"$(git describe --always --dirty --abbrev=7)\"'\"}'",
    "watch": "pnpm build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm typecheck && for d in scene-io asset-path webview-pane community modality review-fsrs run-task lesson-tree lesson-picker chat-format mcp-connect contributes lesson-walk; do echo \"--- $d ---\" && tsx \"src/$d.driver.ts\" || exit 1; done",
    "package": "pnpm build && npx --yes @vscode/vsce package --no-dependencies -o studium.vsix",
    "vendor": "mkdir -p media/vendor/katex/fonts && cp node_modules/marked/marked.min.js media/vendor/marked.min.js && cp node_modules/katex/dist/katex.min.js node_modules/katex/dist/katex.min.css node_modules/katex/dist/contrib/mhchem.min.js media/vendor/katex/ && cp -R node_modules/katex/dist/fonts/. media/vendor/katex/fonts/ && cp node_modules/vega/build/vega.min.js node_modules/vega-lite/build/vega-lite.min.js node_modules/vega-embed/build/vega-embed.min.js media/vendor/ && cp node_modules/cytoscape/dist/cytoscape.min.js node_modules/dagre/dist/dagre.min.js node_modules/cytoscape-dagre/dist/cytoscape-dagre.js node_modules/3dmol/build/3Dmol-min.js media/vendor/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@studium/typed-graph-lens": "workspace:*"
  },
  "devDependencies": {
    "3dmol": "^2.5.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "dagre": "^0.8.5",
    "esbuild": "^0.21.0",
    "jsdom": "29.1.1",
    "katex": "0.16.9",
    "marked": "15.0.12",
    "tsx": "4.21.0",
    "vega": "^5.33.1",
    "vega-embed": "^6.29.0",
    "vega-lite": "^5.23.0"
  }
}
