{
  "name": "studium-vscode",
  "displayName": "Studium",
  "description": "%extension.description%",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "private": true,
  "publisher": "holobiomicslab",
  "repository": {
    "type": "git",
    "url": "https://github.com/HolobiomicsLab/studium.git",
    "directory": "apps/studium-vscode"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onNotebook:studium-lesson",
    "onView:studiumLessons",
    "onCommand:studium.openLesson",
    "onCommand:studium.pickLesson",
    "onCommand:studium.openLessonNotebook",
    "onCommand:studium.communityContributions",
    "onCommand:studium.runReproduction",
    "onCommand:studium.openWalkthrough",
    "onChatParticipant:studium.tutor",
    "onStartupFinished",
    "onUri",
    "onWebviewPanel:studiumLesson",
    "onCommand:studium.openThisLesson",
    "onCommand:studium.forgetMyData"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "studium.openLesson",
        "title": "%command.openLesson.title%"
      },
      {
        "command": "studium.pickLesson",
        "title": "%command.pickLesson.title%"
      },
      {
        "command": "studium.openLessonNotebook",
        "title": "%command.openLessonNotebook.title%"
      },
      {
        "command": "studium.communityContributions",
        "title": "%command.communityContributions.title%"
      },
      {
        "command": "studium.runReproduction",
        "title": "%command.runReproduction.title%"
      },
      {
        "command": "studium.openWalkthrough",
        "title": "%command.openWalkthrough.title%"
      },
      {
        "command": "studium.refreshLessons",
        "title": "%command.refreshLessons.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "studium.openThisLesson",
        "title": "%command.openThisLesson.title%"
      },
      {
        "command": "studium.forgetMyData",
        "title": "%command.forgetMyData.title%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "studium",
          "title": "Studium",
          "icon": "media/studium-icon.svg"
        }
      ]
    },
    "views": {
      "studium": [
        {
          "id": "studiumLessons",
          "name": "%view.lessons.name%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "studium.refreshLessons",
          "when": "view == studiumLessons",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "studium.refreshLessons",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "studium.openThisLesson",
          "when": "resourceFilename == lesson.json",
          "group": "navigation@100"
        }
      ],
      "editor/title/context": [
        {
          "command": "studium.openThisLesson",
          "when": "resourceFilename == lesson.json",
          "group": "navigation@100"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "studium.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "open",
            "title": "%walkthrough.step.open.title%",
            "description": "%walkthrough.step.open.description%",
            "media": {
              "image": {
                "dark": "media/walkthrough/pane-dark.svg",
                "light": "media/walkthrough/pane-light.svg",
                "hc": "media/walkthrough/pane-dark.svg",
                "altText": "%walkthrough.media.pane.alt%"
              }
            },
            "completionEvents": [
              "onCommand:studium.openLesson",
              "onCommand:studium.pickLesson"
            ]
          },
          {
            "id": "selfStudy",
            "title": "%walkthrough.step.selfStudy.title%",
            "description": "%walkthrough.step.selfStudy.description%",
            "media": {
              "markdown": "media/walkthrough/self-study.md"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          },
          {
            "id": "judge",
            "title": "%walkthrough.step.judge.title%",
            "description": "%walkthrough.step.judge.description%",
            "media": {
              "image": {
                "dark": "media/walkthrough/deck-dark.svg",
                "light": "media/walkthrough/deck-light.svg",
                "hc": "media/walkthrough/deck-dark.svg",
                "altText": "%walkthrough.media.deck.alt%"
              }
            },
            "completionEvents": [
              "onStepSelected"
            ]
          },
          {
            "id": "run",
            "title": "%walkthrough.step.run.title%",
            "description": "%walkthrough.step.run.description%",
            "media": {
              "markdown": "media/walkthrough/03-run.md"
            },
            "completionEvents": [
              "onCommand:studium.runReproduction"
            ]
          },
          {
            "id": "review",
            "title": "%walkthrough.step.review.title%",
            "description": "%walkthrough.step.review.description%",
            "media": {
              "image": {
                "dark": "media/walkthrough/review-dark.svg",
                "light": "media/walkthrough/review-light.svg",
                "hc": "media/walkthrough/review-dark.svg",
                "altText": "%walkthrough.media.review.alt%"
              }
            },
            "completionEvents": [
              "onView:studiumLessons"
            ]
          }
        ]
      }
    ],
    "chatParticipants": [
      {
        "id": "studium.tutor",
        "name": "studium",
        "fullName": "Studium",
        "description": "%chat.participant.description%",
        "isSticky": true,
        "commands": [
          {
            "name": "start",
            "description": "%chat.command.start.description%"
          },
          {
            "name": "hint",
            "description": "%chat.command.hint.description%"
          },
          {
            "name": "discuss",
            "description": "%chat.command.discuss.description%"
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "studium-run",
        "required": [
          "capsule"
        ],
        "properties": {
          "capsule": {
            "type": "string",
            "description": "The capsule_ref the reproduction scene runs (provisioned + executed in the user's workspace; Studium never executes)."
          }
        }
      }
    ],
    "notebooks": [
      {
        "type": "studium-lesson",
        "displayName": "Studium Lesson",
        "selector": [
          {
            "filenamePattern": "*.studium-lesson"
          }
        ]
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "studium.repoRoot": {
          "type": "string",
          "default": "",
          "description": "%configuration.repoRoot.description%"
        },
        "studium.bundlesRoot": {
          "type": "string",
          "default": "",
          "description": "%configuration.bundlesRoot.description%"
        },
        "studium.bundleRef": {
          "type": "string",
          "default": "atomistique-l1/lesson.json",
          "description": "%configuration.bundleRef.description%"
        },
        "studium.communityBundlesRoot": {
          "type": "string",
          "default": "",
          "description": "%configuration.communityBundlesRoot.description%"
        },
        "studium.assets": {
          "type": "string",
          "enum": [
            "vendor",
            "cdn"
          ],
          "default": "vendor",
          "description": "%configuration.assets.description%",
          "enumDescriptions": [
            "%configuration.assets.enum.0%",
            "%configuration.assets.enum.1%"
          ]
        },
        "studium.learnerId": {
          "type": "string",
          "default": "vscode-learner",
          "description": "%configuration.learnerId.description%"
        },
        "studium.telemetryConsent": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.telemetryConsent.description%"
        },
        "studium.showGraph": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showGraph.description%"
        },
        "studium.graphView": {
          "type": "string",
          "enum": [
            "student",
            "teacher"
          ],
          "default": "student",
          "description": "%configuration.graphView.description%",
          "enumDescriptions": [
            "%configuration.graphView.enum.0%",
            "%configuration.graphView.enum.1%"
          ]
        },
        "studium.showMastery": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.showMastery.description%"
        },
        "studium.modalityPreference": {
          "type": "string",
          "enum": [
            "visual",
            "textual",
            "balanced"
          ],
          "enumDescriptions": [
            "%configuration.modalityPreference.enum.0%",
            "%configuration.modalityPreference.enum.1%",
            "%configuration.modalityPreference.enum.2%"
          ],
          "default": "balanced",
          "description": "%configuration.modalityPreference.description%"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "studiumLessons",
        "contents": "%viewsWelcome.empty%"
      }
    ]
  },
  "scripts": {
    "build": "pnpm vendor && esbuild src/extension.ts --loader:.css=text --loader:.html=text --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js && esbuild src/lesson-mcp-entry.ts --loader:.html=text --bundle --platform=node --format=cjs --outfile=dist/lesson-mcp.cjs --define:__STUDIUM_BUILD__='{\"origin\":\"bundled\",\"built_at\":\"'\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"'\",\"git_sha\":\"'\"$(git describe --always --dirty --abbrev=7)\"'\"}'",
    "watch": "pnpm build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm typecheck && for d in context-help scene-io asset-path webview-pane community modality review-fsrs run-task run-trust host-phrases data-paths lesson-uri pane-messages study-status lesson-tree lesson-picker completion chat-format mcp-connect panel-lifecycle contributes lesson-walk extension-host; do echo \"--- $d ---\" && tsx \"src/$d.driver.ts\" || exit 1; done",
    "package": "pnpm vendor && pnpm build && vsce package --no-dependencies -o studium.vsix",
    "vendor": "pnpm --filter @studium/lesson-panel-ui build && mkdir -p dist/panel && cp -R ../lesson-panel-ui/dist/vscode/. dist/panel/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@studium/typed-graph-lens": "workspace:*",
    "@studium/lesson-panel": "workspace:*",
    "@studium/lesson-panel-ui": "workspace:*"
  },
  "devDependencies": {
    "3dmol": "^2.5.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "3.2.1",
    "axe-core": "4.10.3",
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "dagre": "^0.8.5",
    "esbuild": "^0.21.0",
    "jsdom": "29.1.1",
    "katex": "0.16.9",
    "marked": "15.0.12",
    "tsx": "4.21.0",
    "vega": "^5.33.1",
    "vega-embed": "^6.29.0",
    "vega-lite": "^5.23.0"
  },
  "icon": "media/walkthrough/studium-icon-128.png",
  "galleryBanner": {
    "color": "#13252c",
    "theme": "dark"
  }
}
