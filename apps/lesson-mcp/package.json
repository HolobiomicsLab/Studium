{
  "name": "@studium/lesson-mcp",
  "version": "0.6.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Studium lesson server for MCP clients (Codex, Claude Code, Copilot): plays and reviews Studium lessons over stdio.",
  "bin": {
    "studium-mcp": "dist/studium-mcp.cjs"
  },
  "files": [
    "dist/studium-mcp.cjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm --filter @studium/lesson-panel-ui build && vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "start": "pnpm --filter @studium/lesson-panel-ui build && tsx src/index.ts",
    "api": "pnpm --filter @studium/lesson-panel-ui build && tsx src/http-entry.ts",
    "api:call": "tsx src/http-client.ts",
    "bundle": "pnpm --filter @studium/lesson-panel-ui build && esbuild ../studium-vscode/src/lesson-mcp-entry.ts --loader:.html=text --bundle --platform=node --format=cjs --banner:js='#!/usr/bin/env node' --outfile=dist/studium-mcp.cjs --define:__STUDIUM_BUILD__='{\"origin\":\"bundled\",\"built_at\":\"'\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"'\",\"git_sha\":\"'\"$(git describe --always --dirty --abbrev=7)\"'\"}'",
    "prepack": "pnpm run bundle"
  },
  "dependencies": {
    "@studium/lesson-session": "workspace:*",
    "@studium/lesson-session-host": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "3.25.2",
    "@studium/lesson-panel-ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0",
    "typescript": "^5.5.0",
    "esbuild": "^0.28.2"
  }
}
