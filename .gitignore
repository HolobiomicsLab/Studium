# Generic build artifacts
build/

# Playwright / e2e test artifacts
playwright-report/
test-results/
fixtures/m6/demo-atomistique-bundle.zip

# pnpm local content-addressable store (regenerable)
.pnpm-store/

# Perspicacité search cache (on-disk, reproducible re-gen)
.cache/

# Eval corpus — third-party OER teaching material (some all-rights-reserved); kept local, re-fetchable from eval/corpus/manifest.json
eval/corpus/

# Runtime/author-time local artifacts — NEVER commit
.lwg/          # planner LWG output (lwg.indicium.jsonld, astra.yaml, universes/)
.mastery/      # RGPD: local learner mastery claims (demonstrates_mastery_of) — personal data, must never be pushed

# TypeScript emitted artifacts inside src/ — never commit (npx tsc / tsx run leave these)
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map
apps/*/src/**/*.js
apps/*/src/**/*.d.ts
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts.map

# Vendored third-party libs for the VS Code extension — regenerate with `pnpm --filter studium-vscode vendor`
apps/studium-vscode/media/vendor/

# Local symlink to the eval corpus repo (~/git/studium_eval/corpus) — machine-specific, never commit
eval/corpus

# runtime telemetry from the VS Code demo (studium.telemetryConsent)
fixtures/data/

# Studium agentic-session file channel (run by the operator CLIs / demo)
.studium-session/
