    dct:modified "2026-11-12"^^xsd:date ;
    dct:publisher <https://holobiomicslab.cnrs.fr/> ;
    dct:title "Studium vocabulary"@en,
        "Vocabulaire de Studium"@fr ;
    vann:preferredNamespacePrefix "studium" ;
    vann:preferredNamespaceUri "https://w3id.org/studium#" ;
    owl:versionInfo "0.1" .

