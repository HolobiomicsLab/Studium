      {
        "@language": "en",
        "@value": "A scene in which the learner declares how confident they are (0 to 4), once or before and after."
      },
      {
        "@language": "fr",
        "@value": "Scène dans laquelle l'apprenant déclare sa confiance (de 0 à 4), une fois ou avant et après."
      }
