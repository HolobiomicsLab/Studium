<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:dct="http://purl.org/dc/terms/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:vann="http://purl.org/vocab/vann/">
  <rdf:Description rdf:about="https://holobiomicslab.cnrs.fr/ns/studium">
    <dct:description xml:lang="fr">Termes pour les éléments d'une leçon Studium : la version 0.1 nomme les types de scène d'une leçon.</dct:description>
    <dct:description xml:lang="en">Terms for the parts of a Studium lesson: version 0.1 names the scene types of a lesson bundle.</dct:description>
    <dct:license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-12</dct:modified>
    <dct:publisher rdf:resource="https://holobiomicslab.cnrs.fr/"/>
    <dct:title xml:lang="en">Studium vocabulary</dct:title>
    <dct:title xml:lang="fr">Vocabulaire de Studium</dct:title>
    <vann:preferredNamespacePrefix>studium</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/studium#</vann:preferredNamespaceUri>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionInfo>0.1</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/studium#SceneTypeScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://holobiomicslab.cnrs.fr/ns/studium"/>
    <rdfs:seeAlso rdf:resource="https://github.com/HolobiomicsLab/Studium/blob/main/docs/concepts/scene-types.md"/>
    <skos:definition xml:lang="fr">Les types que peut avoir une scène d'une leçon Studium : ce que l'on demande à l'apprenant dans chacun.</skos:definition>
    <skos:definition xml:lang="en">The types a scene of a Studium lesson bundle can have: what the learner is asked to do in each.</skos:definition>
    <skos:prefLabel xml:lang="en">scene types</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">types de scène</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/studium#ai_critique">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://holobiomicslab.cnrs.fr/ns/studium"/>
    <skos:definition xml:lang="en">A scene in which the learner critiques an AI production.</skos:definition>
    <skos:definition xml:lang="fr">Scène dans laquelle l'apprenant critique une production de l'IA.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/studium#SceneTypeScheme"/>
    <skos:notation>ai_critique</skos:notation>
    <skos:prefLabel xml:lang="en">ai critique</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/studium#communication_sim">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://holobiomicslab.cnrs.fr/ns/studium"/>
    <skos:definition xml:lang="en">A scene in which the learner communicates a message to an audience, in a professional role.</skos:definition>
    <skos:definition xml:lang="fr">Scène dans laquelle l'apprenant transmet un message à un public, dans un rôle professionnel.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/studium#SceneTypeScheme"/>
    <skos:notation>communication_sim</skos:notation>
    <skos:prefLabel xml:lang="en">communication sim</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/studium#comparison">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://holobiomicslab.cnrs.fr/ns/studium"/>
    <skos:definition xml:lang="en">A scene in which the learner compares two objects or explanations.</skos:definition>
    <skos:definition xml:lang="fr">Scène dans laquelle l'apprenant compare deux objets ou deux explications.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/studium#SceneTypeScheme"/>
    <skos:notation>comparison</skos:notation>
    <skos:prefLabel xml:lang="en">comparison</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/studium#concept">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://holobiomicslab.cnrs.fr/ns/studium"/>
    <skos:definition xml:lang="en">A scene in which the learner reads and works with one idea.</skos:definition>
    <skos:definition xml:lang="fr">Scène dans laquelle l'apprenant lit et manipule une idée.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/studium#SceneTypeScheme"/>
    <skos:notation>concept</skos:notation>
    <skos:prefLabel xml:lang="en">concept</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/studium#discussion">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://holobiomicslab.cnrs.fr/ns/studium"/>
    <skos:definition xml:lang="en">A scene in which the learner reasons with a tutor over several turns.</skos:definition>
    <skos:definition xml:lang="fr">Scène dans laquelle l'apprenant raisonne avec un tuteur sur plusieurs tours.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/studium#SceneTypeScheme"/>
    <skos:notation>discussion</skos:notation>
    <skos:prefLabel xml:lang="en">discussion</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/studium#explain_back">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://holobiomicslab.cnrs.fr/ns/studium"/>
    <skos:definition xml:lang="en">A scene in which the learner explains the idea in their own words, as if teaching it.</skos:definition>
    <skos:definition xml:lang="fr">Scène dans laquelle l'apprenant explique l'idée avec ses mots, comme s'il l'enseignait.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/studium#SceneTypeScheme"/>
    <skos:notation>explain_back</skos:notation>
    <skos:prefLabel xml:lang="en">explain back</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/studium#intro">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://holobiomicslab.cnrs.fr/ns/studium"/>
    <skos:definition xml:lang="en">A scene in which the learner sees the goal and the path of the lesson.</skos:definition>
    <skos:definition xml:lang="fr">Scène dans laquelle l'apprenant découvre l'objectif et le parcours de la leçon.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/studium#SceneTypeScheme"/>
    <skos:notation>intro</skos:notation>
    <skos:prefLabel xml:lang="en">intro</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/studium#meta_checkpoint">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://holobiomicslab.cnrs.fr/ns/studium"/>
    <skos:definition xml:lang="en">A scene in which the learner declares how confident they are (0 to 4), once or before and after.</skos:definition>
    <skos:definition xml:lang="fr">Scène dans laquelle l'apprenant déclare sa confiance (de 0 à 4), une fois ou avant et après.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/studium#SceneTypeScheme"/>
    <skos:notation>meta_checkpoint</skos:notation>
    <skos:prefLabel xml:lang="en">meta checkpoint</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/studium#prompt_practice">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://holobiomicslab.cnrs.fr/ns/studium"/>
    <skos:definition xml:lang="en">A scene in which the learner writes or improves a prompt for a task.</skos:definition>
    <skos:definition xml:lang="fr">Scène dans laquelle l'apprenant rédige ou améliore une consigne pour une tâche.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/studium#SceneTypeScheme"/>
    <skos:notation>prompt_practice</skos:notation>
    <skos:prefLabel xml:lang="en">prompt practice</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/studium#quiz">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://holobiomicslab.cnrs.fr/ns/studium"/>
    <skos:definition xml:lang="en">A scene in which the learner chooses an answer.</skos:definition>
    <skos:definition xml:lang="fr">Scène dans laquelle l'apprenant choisit une réponse.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/studium#SceneTypeScheme"/>
    <skos:notation>quiz</skos:notation>
    <skos:prefLabel xml:lang="en">quiz</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/studium#reproduction">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://holobiomicslab.cnrs.fr/ns/studium"/>
    <skos:definition xml:lang="en">A scene in which the learner has the harness run a protocol, then examines the result.</skos:definition>
    <skos:definition xml:lang="fr">Scène dans laquelle l'apprenant fait exécuter un protocole par le harnais, puis examine le résultat.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/studium#SceneTypeScheme"/>
    <skos:notation>reproduction</skos:notation>
    <skos:prefLabel xml:lang="en">reproduction</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/studium#spot_the_flaw">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://holobiomicslab.cnrs.fr/ns/studium"/>
    <skos:definition xml:lang="en">A scene in which the learner finds the errors in a deliberately flawed text.</skos:definition>
    <skos:definition xml:lang="fr">Scène dans laquelle l'apprenant repère les erreurs d'un texte volontairement fautif.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/studium#SceneTypeScheme"/>
    <skos:notation>spot_the_flaw</skos:notation>
    <skos:prefLabel xml:lang="en">spot the flaw</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/studium#summary_audit">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://holobiomicslab.cnrs.fr/ns/studium"/>
    <skos:definition xml:lang="en">A scene in which the learner checks an AI summary for omissions and distortions.</skos:definition>
    <skos:definition xml:lang="fr">Scène dans laquelle l'apprenant vérifie les omissions et déformations d'un résumé produit par l'IA.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/studium#SceneTypeScheme"/>
    <skos:notation>summary_audit</skos:notation>
    <skos:prefLabel xml:lang="en">summary audit</skos:prefLabel>
  </rdf:Description>
</rdf:RDF>
