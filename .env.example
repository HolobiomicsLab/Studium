# Studium environment variables: a commented template.
#
# Nothing loads this file automatically. Copy the lines you need into your shell, your harness
# configuration (see docs/examples/) or your service manager, and remove the leading "# ".
# Every variable is optional unless marked "required"; the value shown is the default.
# Reference: docs/reference/configuration.md

# --- Lessons and progress (lesson-mcp; also the VS Code extension and the teacher dashboard) ---
# Root of the learner's library (<home>/library) and data (<home>/data). Default: ~/.studium
# (give an absolute path: an env file does not expand ~).
# STUDIUM_HOME=
# Folder a bundle_ref is looked up in first (lesson-mcp default: $STUDIUM_HOME/library).
# BUNDLES_ROOT=
# Durable learner state (lesson-mcp default: $STUDIUM_HOME/data; lesson-server and the HTTP API
# keep state in memory unless this is set).
# STUDIUM_DATA_DIR=
# 1 keeps learner state in memory only, lost at restart (tests, demos, CI).
# STUDIUM_EPHEMERAL=1
# Learner id used when a call names none.
# STUDIUM_LEARNER_ID=anonymous

# --- Privacy (lesson-mcp, lesson-server, HTTP API) ---
# HMAC secret of on-disk learner pseudonyms. Default: a per-install file <data dir>/.studium-secret.
# Keep it with the data folder; changing it orphans existing learner folders.
# STUDIUM_PSEUDO_SECRET=
# "production" refuses to start a session without a real pseudonym secret.
# NODE_ENV=production
# STUDIUM_ENV=production
# 1 / true / granted / yes writes consented, pseudonymised class telemetry (needs a data folder).
# STUDIUM_TELEMETRY_CONSENT=
# Any value gives each learner their own reproducible order of quiz choices.
# STUDIUM_PER_LEARNER_SHUFFLE=
# In memory-only mode, a folder to write mastery claims to.
# STUDIUM_MASTERY_DIR=

# --- Judge model (optional; lesson-mcp, lesson-server, planner) ---
# OpenAI-compatible endpoint (for example a LiteLLM proxy). Empty = no model.
# LITELLM_BASE_URL=
# LITELLM_API_KEY=
# Model name of the audit judge.
# LITELLM_MODEL=studium/audit-judge
# Timeout of a scoring or tutoring call, in milliseconds.
# STUDIUM_LLM_TIMEOUT_MS=20000

# --- HTTP API of lesson-mcp (pnpm --filter @studium/lesson-mcp api) ---
# Required: bearer token of at least 32 characters (for example: openssl rand -hex 32).
# STUDIUM_API_TOKEN=
# STUDIUM_API_PORT=8130
# 1 lets the API call the model of LITELLM_BASE_URL.
# STUDIUM_API_LIVE=
# Origin used by the api:call client.
# STUDIUM_API_URL=http://127.0.0.1:8130

# --- lesson-server (pnpm --filter @studium/lesson-server start) ---
# BUNDLES_ROOT defaults to the current directory here.
# PORT=8010

# --- Teacher dashboard ---
# ANALYTICS_BASE_URL=http://localhost:8003
# SCENE_SYNTH_BASE_URL=http://localhost:8002
# LESSON_SERVER_BASE_URL=http://localhost:8010
# OBSERVATORY_BASE_URL=http://localhost:8004

# --- analytics-collector ---
# Where collected telemetry is stored (relative to the working directory).
# ANALYTICS_DATA_DIR=data
# Smallest cohort a class figure is computed over.
# ANALYTICS_MIN_LEARNERS=5

# --- scene-synth ---
# BUNDLES_ROOT defaults to the repository's fixtures/ here.
# Where approved learner contributions are written (default: BUNDLES_ROOT).
# COMMUNITY_BUNDLES_ROOT=
# LEARNER_DATA_ROOT=/tmp/studium-learner-items
# Set this in any real deployment.
# LEARNER_PSEUDONYM_SECRET=dev-insecure-secret
# Staging folder of the demo bundle (demo_fresh.py).
# BUNDLE_DIR=

# --- Planner (answers 503 until a model is configured) ---
# litellm calls LITELLM_BASE_URL (planner default http://localhost:4000); mock is for tests and demos.
# STUDIUM_LLM_MODE=
# on builds the learning workflow graph of each plan.
# STUDIUM_LWG_BUILD=
# STUDIUM_LWG_OUT_DIR=.lwg
# on enriches plans with literature evidence.
# STUDIUM_EVIDENCE_ENRICH=
# on enables the Perspicacite literature client; mock uses a mock client.
# STUDIUM_PERSPICACITE_ENABLED=
# STUDIUM_PERSPICACITE_MODE=
# PERSPICACITE_MCP_URL=http://localhost:8000/mcp
# PERSPICACITE_DOMAIN_KB=
# off disables the on-disk search cache.
# STUDIUM_PERSPICACITE_CACHE=on
# STUDIUM_PERSPICACITE_CACHE_DIR=.cache/perspicacite

# --- Build identity (lesson-mcp run from sources) ---
# JSON {origin, built_at, git_sha} reported by get_server_info instead of asking git.
# STUDIUM_BUILD_INFO=

# --- Teacher dashboard end-to-end tests ---
# DASHBOARD_PORT=3001
# DASHBOARD_PORT_EXTERNAL=
# PLAYWRIGHT_CHANNEL=
